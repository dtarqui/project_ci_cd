# Variables de entorno del backend.
# Copia este archivo a .env y ajusta los valores segun tu entorno.
#
# OBLIGATORIA = sin ella el servidor no arranca (o arranca en modo inseguro).
# OPCIONAL    = tiene un valor por defecto seguro si no se define.

# OPCIONAL (default: 4000)
PORT=4000

# OPCIONAL (default: development).
# Usa "production" en despliegues reales: activa validaciones estrictas,
# como exigir un JWT_SECRET fuerte.
NODE_ENV=development

# OPCIONAL (default: memory). Switch unico para toda la capa de datos
# (users, customers, products, sales, dashboard):
#   memory   -> datos en RAM, sin BD (desarrollo rapido y tests automatizados)
#   database -> Postgres real via Supabase/Prisma (requiere DATABASE_URL)
REPOSITORY_MODE=memory

# OBLIGATORIA solo si REPOSITORY_MODE=database; si no, dejar comentada.
# Si tu red no tiene salida IPv6, usa el "Session pooler" de Supabase en vez
# de la conexion directa (esta es IPv6-only).
# DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# OPCIONAL (default: "*")
CORS_ALLOW_ORIGIN=*
# OPCIONAL (default: GET,POST,PUT,DELETE,OPTIONS,PATCH,HEAD)
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH,HEAD
# OPCIONAL (default: Origin, X-Requested-With, Content-Type, Accept, Authorization)
CORS_ALLOW_HEADERS=Origin, X-Requested-With, Content-Type, Accept, Authorization

# OBLIGATORIA cuando NODE_ENV=production: el arranque falla si falta o si
# tiene menos de 32 caracteres. En desarrollo es OPCIONAL — si no se define,
# se usa un secreto fijo inseguro ("dev-only-jwt-secret-change-me"), valido
# unicamente para trabajar en local.
JWT_SECRET=change-this-secret-in-production

# OPCIONAL (default: 1h)
JWT_EXPIRES_IN=1h
# OPCIONAL (default: HS256). Solo se acepta HS256/HS384/HS512; cualquier
# otro valor cae de vuelta a HS256.
JWT_ALGORITHM=HS256
# OPCIONAL. Si no se define, el token no incluye "issuer".
JWT_ISSUER=ci-cd-backend
# OPCIONAL. Si no se define, el token no incluye "audience".
JWT_AUDIENCE=ci-cd-frontend
