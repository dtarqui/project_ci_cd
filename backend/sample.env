# Backend environment variables
PORT=4000
NODE_ENV=development

# Un solo switch para toda la capa de datos (users, customers, products, sales, dashboard):
# "memory" (default, sin BD) o "database" (Postgres/Supabase vía Prisma)
REPOSITORY_MODE=memory

# Requerido solo cuando REPOSITORY_MODE = "database".
# Si tu red no tiene salida IPv6, usa el "Session pooler" en vez de la conexión directa.
# DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

CORS_ALLOW_ORIGIN=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH,HEAD
CORS_ALLOW_HEADERS=Origin, X-Requested-With, Content-Type, Accept, Authorization
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1h
JWT_ALGORITHM=HS256
JWT_ISSUER=ci-cd-backend
JWT_AUDIENCE=ci-cd-frontend
