// Prisma schema - modo "database" (Postgres/Supabase).
// El modo "memory" (default) no depende de este archivo en tiempo de ejecución.
// Ver codigo/backend/src/db/prismaClient.js y README para activarlo.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Catalogos administrables desde la pantalla de configuracion ---
//
// Las ciudades vivian en una constante del codigo y las categorias no existian
// como entidad: el desplegable se armaba con los valores distintos de los
// productos cargados. Ahora son tablas con su propio CRUD, restringido al rol
// admin. Borrado logico, por el mismo motivo que Customer y Product.
//
// No hay catalogo de paises: el caso de estudio opera unicamente en Bolivia.

model City {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  postalPrefix String?   @map("postal_prefix")
  areaCode     String?   @map("area_code")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@map("cities")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("categories")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String?  @unique
  passwordHash String   @map("password_hash")
  role         String   @default("vendedor")
  name         String?
  phone        String?
  address      String?
  city         String?
  state        String?
  postalCode   String?  @map("postal_code")
  dateOfBirth  String?  @map("date_of_birth")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  sales        Sale[]

  @@map("users")
}

model Customer {
  id             Int       @id @default(autoincrement())
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  postalCode     String?   @map("postal_code")
  status         String    @default("Activo")
  registeredDate String?   @map("registered_date")
  totalSpent     Float     @default(0) @map("total_spent")
  purchases      Int       @default(0)
  lastPurchase   String?   @map("last_purchase")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  // Borrado logico: la fila se conserva para que las ventas que la referencian
  // sigan resolviendo. null = activo. Ver repositories/customerRepository.js.
  deletedAt      DateTime? @map("deleted_at")
  sales          Sale[]

  @@map("customers")
}

model Product {
  id        Int        @id @default(autoincrement())
  name      String
  category  String?
  price     Float
  stock     Int        @default(0)
  status    String     @default("En Stock")
  lastSale  String?    @map("last_sale")
  sales     Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  saleItems SaleItem[]

  // Borrado logico, por el mismo motivo que en Customer: sale_items
  // referencia productos y la BD no deja borrar la fila referenciada.
  deletedAt DateTime? @map("deleted_at")

  @@map("products")
}

model Sale {
  id            Int        @id @default(autoincrement())
  customerId    Int        @map("customer_id")
  customer      Customer   @relation(fields: [customerId], references: [id])
  customerName  String     @map("customer_name")
  userId        Int?       @map("user_id")
  user          User?      @relation(fields: [userId], references: [id])
  userName      String?    @map("user_name")
  subtotal      Float
  discount      Float      @default(0)
  total         Float
  status        String     @default("Completada")
  paymentMethod String?    @map("payment_method")
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  items         SaleItem[]

  @@map("sales")
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int     @map("sale_id")
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  name      String
  quantity  Int
  price     Float
  total     Float

  @@map("sale_items")
}
