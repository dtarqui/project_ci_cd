# Variables de entorno del frontend.
# Copia este archivo a .env y ajusta el valor si tu backend no corre en
# http://localhost:4000.
#
# OBLIGATORIA = sin ella la app no funciona correctamente.
# OPCIONAL    = tiene un valor por defecto seguro si no se define.

# OPCIONAL. Si no se define:
#   - en desarrollo (NODE_ENV != production) se usa http://localhost:4000
#   - en produccion se usan rutas relativas ("/"), pensado para rewrites de Vercel
API_BASE_URL=http://localhost:4000
